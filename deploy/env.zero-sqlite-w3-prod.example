# Zero SQLite Wave 3 — production target (real.gomira.vn / rnosai VPS)
#
# Merge into /var/www/realosai/.env (or deploy/runtime.env). Do NOT commit secrets.
#
# Verify locally:
#   set -a && source deploy/env.zero-sqlite-w3-prod.example && set +a
#   ./scripts/ci_zero_sqlite_w3_gate.sh
#
# Prerequisite: Wave 0–2 Nest PG deployed (PTT_SQLITE_DISABLED=1, all PTT_CRM_*_PG=1).

# ── PostgreSQL OLTP (required) ──
export DATABASE_URL="${DATABASE_URL:-postgresql://ptt:CHANGE_ME@127.0.0.1:5433/rnosaidb}"

# ── Zero SQLite hard-ban (Wave 0) ──
export PTT_SQLITE_DISABLED=1
# Do NOT set PTT_SQLITE_PATH on production — Nest ignores it (Wave 4 PG-only).

# ── Leads ──
export PTT_LEADS_READ_SOURCE=pg
export PTT_LEADS_WRITE_SOURCE=pg
export PTT_LEAD_SHADOW_SYNC=0
export PTT_LEAD_INGEST_RULES_SOURCE=pg
export PTT_LEADS_WRITE_UPSTREAM=nest
export PTT_NEST_LEADS_URL=http://127.0.0.1:3010

# ── Wave 1 CRM modules (PG-primary) ──
export PTT_CRM_CUSTOMERS_PG=1
export PTT_CRM_CASES_PG=1
export PTT_CRM_TICKETS_PG=1
export PTT_CRM_PROPOSALS_PG=1
export PTT_CRM_MARKETING_PLANS_PG=1
export PTT_CRM_CONFIG_PG=1
export PTT_CRM_ORDERS_PG=1
export PTT_CRM_INVOICES_PG=1
export PTT_CRM_SALES_PG=1
export PTT_CRM_OWNER_WEEKLY_PG=1
export PTT_CRM_PAYROLL_PG=1

# ── Dual-write modules (PG when disabled=1) ──
export PTT_CRM_LEADS_LEGACY_PG=1
export PTT_CRM_LEADS_FUNNEL_PG=1
export PTT_CRM_LEADS_CONTRACT_PG=1
export PTT_CRM_STAFF_PG=1
export PTT_CRM_SERVICE_LIFECYCLE_PG=1
export PTT_CRM_FINANCE_PG=1
export PTT_CRM_SVC_FINANCE_PG=1
export PTT_CRM_KPI_PG=1
export PTT_CRM_SOP_PG=1
export PTT_CRM_INTAKE_PG=1

# ── BĐS (Wave B5) ──
export PTT_BDS_PACK=1
export PTT_BDS_PG=1

# ── Flask retirement (Wave 3 P1) ──
export PTT_FLASK_MONOLITH_MODE=retired
export PTT_WEBHOOKS_FLASK_FALLBACK=0
export CRM_FACEBOOK_BACKGROUND_IN_GUNICORN=0

# ── Webhooks Nest-only ──
export PTT_JOBS_ENABLED=1
export PTT_WEBHOOK_V1_ENQUEUE=1
export PTT_WEBHOOKS_NEST_ENABLED=1
export PTT_WEBHOOKS_NEST_META=1
export PTT_WEBHOOKS_NEST_ZALO=1
export PTT_WEBHOOKS_NEST_GOOGLE=1

# ── Portal SEO native PG ──
export PTT_PORTAL_SEO_ENABLED=1
export PTT_SEO_GOVERNANCE_ENABLED=1

# ── Phase 5 gate expectations (ci_zero_sqlite_w3_gate.sh) ──
export PHASE5_EXPECT_FLASK_MODE=retired
export PHASE5_SKIP_PRIOR_GATES=1
export PTT_ARTIFACTS_DIR=.local-dev
